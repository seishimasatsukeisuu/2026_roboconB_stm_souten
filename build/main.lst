 199:Core/Src/main.c ****         __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_4, 2000);
 200:Core/Src/main.c ****       }
 201:Core/Src/main.c ****       else
 202:Core/Src/main.c ****       {
